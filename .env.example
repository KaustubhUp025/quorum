# Quorum — example environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# ── Required ────────────────────────────────────────────────────────────────

# GitLab personal access token with `api` scope
# Get it from: GitLab → User Settings → Access Tokens
QUORUM_GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Gemini API key (from https://aistudio.google.com)
# Leave empty if using Vertex AI instead (see below)
QUORUM_GEMINI_API_KEY=AIzaSy...

# ── GitLab MCP server (yoda-digital — default, recommended) ─────────────────

# Command used to launch the MCP server subprocess.
# Requires Node.js + npx. The package is downloaded on first run (cached after).
# Override if you have installed it globally: QUORUM_MCP_SERVER_CMD=mcp-gitlab-server
# QUORUM_MCP_SERVER_CMD=npx --yes @zereight/mcp-gitlab

# ── GitLab instance ──────────────────────────────────────────────────────────

# Default is gitlab.com. Change for self-hosted GitLab.
# QUORUM_GITLAB_URL=https://gitlab.com

# ── Gemini model ─────────────────────────────────────────────────────────────

# QUORUM_GEMINI_MODEL=gemini-2.5-pro

# ── Vertex AI (alternative to Gemini API key) ────────────────────────────────
# If QUORUM_USE_VERTEX_AI=true, Application Default Credentials are used.
# Run `gcloud auth application-default login` before starting Quorum.

# QUORUM_USE_VERTEX_AI=false
# QUORUM_GOOGLE_CLOUD_PROJECT=my-gcp-project-id
# QUORUM_GOOGLE_CLOUD_LOCATION=us-central1

# ── Review behaviour ─────────────────────────────────────────────────────────

# Suppress findings with confidence below this value (0–100)
# QUORUM_MIN_CONFIDENCE=60

# Exit 1 (fail CI pipeline) when CRITICAL findings are found
# QUORUM_BLOCK_ON_CRITICAL=true

# Max semantic_code_search results per query
# QUORUM_MAX_SEARCH_RESULTS=5

# Hard cap on Gemini tool-call rounds per review
# QUORUM_MAX_TOOL_ROUNDS=10

# ── Webhook server ────────────────────────────────────────────────────────────

# Port for `quorum serve` (Cloud Run default)
# QUORUM_PORT=8080

# Random string — must match the secret set in GitLab webhook settings
# QUORUM_WEBHOOK_SECRET=

# ── Logging ──────────────────────────────────────────────────────────────────

# QUORUM_LOG_LEVEL=INFO
